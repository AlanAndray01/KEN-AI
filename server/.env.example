# Server environment
# Copy to server/.env and fill in values. Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB — required from Phase 2. Render/Atlas may set MONGO_URI instead;
# the server copies that onto MONGODB_URI when the canonical name is empty.
MONGODB_URI=
# MONGO_URI=

# Auth — required from Phase 3
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INITIAL_ADMIN_EMAIL=
ENABLE_DEV_AUTH_TOOLS=false
ENCRYPTION_KEY=

# Google OAuth — optional until Google login is enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI providers — optional; a provider works only when configured
# Gemini is the default chat engine when GEMINI_API_KEY is set (Google AI Studio free tier).
# Groq is the next hop.
# Comma-separated pools rotate on each request / rate-limit retry.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_KEYS=
CEREBRAS_API_KEY=
CEREBRAS_KEYS=
DEEPSEEK_API_KEY=
DEEPSEEK_KEY=
CF_ACCOUNT_ID=
CF_TOKEN=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Sequential fallback (only hops that are actually configured run):
# 1. Gemini gemini-3.5-flash-lite (then gemini-3.8-flash, then gemini-3.6-flash)
# 2. Groq qwen/qwen3.6-27b then openai/gpt-oss-120b
# 3. DeepSeek deepseek-chat
# 4. Cerebras llama-3.3-70b (not a default — last-resort hop)
# 5. Cloudflare @cf/meta/llama-3.2-3b-instruct
# Image prompts on Cloudflare use @cf/meta/llama-4-scout-17b-16e-instruct.
# Optional extra hop after that chain:
# Example: hop from openai/gpt-oss-20b to openai/gpt-oss-120b.
AI_FALLBACK_PROVIDER_ID=
AI_FALLBACK_MODEL_ID=

# Email (password reset + 6-digit signup verification)
# RESEND_FROM_EMAIL or EMAIL_FROM may be a plain address or Name <email@domain>.
# In development, Ken <onboarding@resend.dev> is used when From is omitted.
# That test sender only delivers to the email on your Resend account until you verify a domain.
# Production requires these to boot; missing/failed delivery also returns 503 EMAIL_UNAVAILABLE.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=

# Mock AI — isolated from production paths; never enable in production
ENABLE_MOCK_AI=false

# Cookie domain for deployed hosts (optional)
COOKIE_DOMAIN=

# File storage (Phase 7) — local disk by default.
# Mongo stores object keys / CDN URL strings, never binary buffers.
# For R2/S3 set STORAGE_PROVIDER=r2|s3 plus bucket, keys, and a public CDN URL.
STORAGE_PROVIDER=local
STORAGE_DIRECTORY=uploads
FILE_MAX_BYTES=10485760
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# Search / image / voice (Phase 8) — optional; unconfigured tools return a clear error
SEARCH_PROVIDER=
SEARCH_API_KEY=
# openai | gemini. Empty + GEMINI_API_KEY uses Gemini Nano Banana 2.
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=
VOICE_PROVIDER=
VOICE_API_KEY=
ANALYSIS_RUNNER_URL=

# Rate limits (Phase 11) — requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=10
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_LOGIN_FAILURE_WINDOW_MS=900000
RATE_LIMIT_CHAT=60
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_SEARCH=30
RATE_LIMIT_IMAGE=10
RATE_LIMIT_VOICE=20
RATE_LIMIT_PASSWORD_RESET=5

# Logging
LOG_LEVEL=info

# Public client config only. Never put API keys or database URIs here.
# Vercel production must set this (or VITE_API_URL) to the Render API, e.g.
# https://api.ken-ai.tech/api — never localhost. Vite inlines it at build time.
VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_URL=

# Landing page at "/" — true shows it, false redirects to sign-in (or to chat
# when already signed in). Leave unset to follow the build: shown by `npm run
# dev`, hidden by `npm run build`.
# Read at BUILD time, so set it in your host's build environment, not at runtime.
VITE_SHOW_LANDING_PAGE=true

# Optional — reports unhandled render crashes to Sentry. Read at BUILD time:
# unset means the Sentry SDK is not even bundled, not a broken integration.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ---------------------------------------------------------------------------
# Multi-Agents — configuration
# Copy to `Multi-Agents/.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Anthropic credentials. Optional if you have already run `claude` / `ant auth
# login` on this machine — the Agent SDK then reuses that stored OAuth profile.
ANTHROPIC_API_KEY=

# Model used by every agent unless a role overrides it.
# Aliases ('opus', 'sonnet', 'haiku') and full ids ('claude-opus-5') both work.
AGENTS_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
AGENTS_EFFORT=high

# How many specialist agents run at the same time.
AGENTS_CONCURRENCY=2

# Hard USD ceiling per individual agent task. The task is stopped by the SDK
# when exceeded and reported as over-budget rather than silently continuing.
AGENTS_TASK_BUDGET_USD=2

# Hard USD ceiling for a whole mission. Remaining tasks are skipped once hit.
AGENTS_MISSION_BUDGET_USD=10

# Wall-clock timeout for a single agent task, in seconds.
AGENTS_TASK_TIMEOUT_SECONDS=900

# Max agentic turns (API round-trips) per task.
AGENTS_MAX_TURNS=40

# Set to "true" to let agents edit files by default. Leave false and pass
# `--apply` on the command line instead — explicit beats implicit.
AGENTS_ALLOW_WRITE=false
